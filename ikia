<script>

/* =========================
   CUSTOM CURSOR
========================= */

const cursor =
document.getElementById("cursor");

const cursorDot =
document.getElementById("cursorDot");

document.addEventListener(
"mousemove",
function(e) {

cursor.style.left =
e.clientX + "px";

cursor.style.top =
e.clientY + "px";

cursorDot.style.left =
e.clientX + "px";

cursorDot.style.top =
e.clientY + "px";

});


document
.querySelectorAll(
"a, button, input, textarea"
)
.forEach(function(element) {

element.addEventListener(
"mouseenter",
function() {

cursor.style.width = "30px";
cursor.style.height = "30px";

});

element.addEventListener(
"mouseleave",
function() {

cursor.style.width = "20px";
cursor.style.height = "20px";

});

});


/* =========================
   DIGITAL CLOCK
========================= */

function updateClock() {

const now = new Date();

document.getElementById(
"clock"
).textContent =
now.toLocaleTimeString(
[],
{
hour:"2-digit",
minute:"2-digit",
second:"2-digit"
}
);

}

setInterval(
updateClock,
1000
);

updateClock();


/* =========================
   DAY / NIGHT MODE
========================= */

function toggleTheme() {

document.documentElement
.classList.toggle("dark");

const button =
document.querySelector(
".theme-button"
);

if(
document.documentElement
.classList.contains("dark")
) {

button.textContent =
"☀ Switch to day";

} else {

button.textContent =
"☾ Switch to night";

}

}


/* =========================
   FLOATING FLOWERS
========================= */

function createFlower() {

const flower =
document.createElement("div");

flower.className =
"flower";

const flowers =
[
"🌸",
"🌷",
"🌼",
"✿",
"♡",
"❀"
];

flower.textContent =
flowers[
Math.floor(
Math.random() *
flowers.length
)
];

flower.style.left =
Math.random() * 100 + "vw";

flower.style.fontSize =
(14 +
Math.random() * 18) + "px";

flower.style.animationDuration =
(6 +
Math.random() * 6) + "s";

document.body.appendChild(
flower
);

setTimeout(
function() {

flower.remove();

},
12000
);

}

setInterval(
createFlower,
1200
);


/* =========================
   GUESTBOOK
========================= */

function signGuestbook(event) {

event.preventDefault();

const name =
document.getElementById(
"guestName"
).value.trim();

const message =
document.getElementById(
"guestMessage"
).value.trim();

const entry =
document.createElement("div");

entry.className =
"entry";

entry.innerHTML =
`
<strong>
${escapeHTML(name)}
</strong>

<p>
${escapeHTML(message)}
</p>
`;

document
.getElementById("messages")
.prepend(entry);

event.target.reset();

}


/* Prevent HTML from being
   inserted into guestbook */

function escapeHTML(text) {

return text.replace(
/[&<>"']/g,
function(character) {

return {

"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"

}[character];

});

}

